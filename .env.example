# Copy this file to .env (or .env.local, which takes precedence) and fill it in.
# BakeFix works with any OpenAI-compatible chat-completions API.

# Base URL of the API. Examples:
#   Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenAI:        https://api.openai.com/v1
#   Local Ollama:  http://localhost:11434/v1
LLM_URL="https://generativelanguage.googleapis.com/v1beta/openai/"

# API key for that server. Local servers such as Ollama need none: leave it empty.
# For Google Gemini, create a key at https://aistudio.google.com/app/api-keys
LLM_API_KEY="your_api_key_here"

# Model name as the server knows it, e.g. gemini-3.5-flash-lite, gpt-4.1-mini, gpt-oss:20b
LLM_MODEL="gemini-3.5-flash-lite"

# Optional: seconds to wait for one LLM call (default 60; local models can be slow).
# LLM_TIMEOUT_SECONDS=60

# Optional: passages sent at once when building a concept map (default 4).
# BakeFix drops to one at a time by itself if the server answers "rate limited".
# LLM_GRAPH_CONCURRENCY=4
